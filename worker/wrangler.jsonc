{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kasaysayan-history-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "kasaysayan-explorer",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    // Add your exact production web origin before deploying the web app.
    "ALLOWED_ORIGINS": "http://localhost:4200,http://127.0.0.1:4200,https://localhost,http://localhost,capacitor://localhost"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ASSISTANT_QUOTA",
        "class_name": "AssistantQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed Durable Objects are available on Workers Free.
      "new_sqlite_classes": ["AssistantQuota"]
    }
  ],
  "observability": {
    "enabled": false
  }
}
